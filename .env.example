# --- Site & compliance -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kuberacommercial.com
# Required before launch: California requires the DRE license number on the website.
NEXT_PUBLIC_DRE_CORPORATE_LICENSE=
NEXT_PUBLIC_DRE_OFFICER_LICENSE=
NEXT_PUBLIC_NMLS_ID=
NEXT_PUBLIC_CONTACT_EMAIL=deals@kuberacommercial.com
NEXT_PUBLIC_CONTACT_PHONE=
# Hosts that render only the express qualifier (proxy.ts).
EXPRESS_HOSTS=kubera.loans,www.kubera.loans

# --- AI ------------------------------------------------------------------------
# Claude ("System Two") for Ask Kubera AI and term sheets.
ANTHROPIC_API_KEY=
# Optional hosted Jev endpoint ("System One"). The built-in rules engine runs when unset.
JEV_API_URL=
JEV_API_KEY=

# --- Twenty CRM ------------------------------------------------------------------
# Base URL without /rest, e.g. https://api.twenty.com or your self-hosted URL.
TWENTY_API_URL=
TWENTY_API_KEY=
# Secret set when creating the webhook (Settings → APIs & Webhooks) pointing at /api/webhooks/twenty.
TWENTY_WEBHOOK_SECRET=

# --- Supabase ------------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security --------------------------------------------------------------------------
# Signs the per-lead upload token (openssl rand -base64 32).
LEAD_TOKEN_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/rates and /api/cron/crm-retry.
CRON_SECRET=

# --- Compliance (WS-A) --------------------------------------------------------
# Main office address on file with the DRE; shown on /licensing and used on the MLDS.
NEXT_PUBLIC_DRE_LICENSED_ADDRESS=
# Set to "true" only after counsel approves the legal pages; until then they show a DRAFT banner.
NEXT_PUBLIC_LEGAL_APPROVED=
# Non-Vercel hosts: set to "production" so the build fails without an 8-digit NEXT_PUBLIC_DRE_CORPORATE_LICENSE (Vercel uses VERCEL_ENV).
DEPLOY_ENV=

# --- Security & AI safety (WS-B) -------------------------------------------------
# Cloudflare Turnstile. Site key is public (rendered in the browser); the secret verifies tokens server-side.
# Leave both empty to disable bot verification (dev/preview). Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST credentials for the shared rate limiter (falls back to per-instance memory when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra origins allowed to POST to the intake APIs, comma-separated (e.g. http://localhost:3999 for e2e on next start).
ALLOWED_ORIGINS=
# Salt for hashing client IPs on AI conversation records (openssl rand -base64 32); defaults to LEAD_TOKEN_SECRET.
IP_HASH_SALT=
# Optional CSP violation report endpoint (report-uri).
CSP_REPORT_URI=
# Advisor evals (npm run evals): minimum pass rate and parallel requests for live runs.
EVAL_MIN_PASS_RATE=0.8
EVAL_CONCURRENCY=4

# --- Observability (Sentry; leave empty to disable) ----------------------------------------
# Server and edge DSN. Without a DSN Sentry is never initialised and one info line is logged.
SENTRY_DSN=
# Browser DSN (public by design). Also add the Sentry ingest origin to the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=
# Overrides the environment label (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
# Server/edge trace sample rate between 0 and 1 (default 0.1).
SENTRY_TRACES_SAMPLE_RATE=
# Browser equivalents of the two settings above.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- Testing ---------------------------------------------------------------------------
# Port the Playwright suite serves the production build on (npm run test:e2e). Default 3999.
E2E_PORT=3999

# --- Disclosures & e-sign (WS-W) ------------------------------------------------
# Kubera's DRE-licensed office address for the MLDS (RE 882); defaults to NEXT_PUBLIC_DRE_LICENSED_ADDRESS.
DRE_LICENSED_ADDRESS=
# Set to "true" only after counsel approves the MLDS / funder templates; until then documents say DRAFT and cannot be sent.
MLDS_TEMPLATE_APPROVED=false
# Force a provider: zoho_sign | boldsign | fake (fake is refused in Vercel production). Empty = Zoho Sign, then BoldSign, if configured.
ESIGN_PROVIDER=
# Zoho Sign OAuth client (api-console.zoho.com, scopes ZohoSign.documents.ALL,ZohoSign.templates.ALL) and its refresh token.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
# Zoho data center TLD: com (US), eu, in, com.au, jp, ca, sa.
ZOHO_SIGN_DC=com
# Zoho Sign template for the MLDS; field labels must match mldsPrefillFields() and roles "Borrower 1".."Borrower N", "Broker".
ZOHO_SIGN_MLDS_TEMPLATE_ID=
# Secret key set on the Zoho Sign webhook pointing at /api/webhooks/zoho-sign.
ZOHO_SIGN_WEBHOOK_SECRET=
# BoldSign fallback (only used when Zoho Sign is not configured or ESIGN_PROVIDER=boldsign).
BOLDSIGN_API_KEY=
BOLDSIGN_WEBHOOK_SECRET=
BOLDSIGN_MLDS_TEMPLATE_ID=

# --- Trust pages (WS-G) ----------------------------------------------------------
# Cal.com booking handle for the /contact embed, e.g. kubera/intro. Empty shows an email fallback instead.
NEXT_PUBLIC_CALCOM_LINK=
# Office address shown on /contact; falls back to NEXT_PUBLIC_DRE_LICENSED_ADDRESS when empty.
NEXT_PUBLIC_OFFICE_ADDRESS=

# --- Analytics (WS-H) -----------------------------------------------------------
# Cookieless, PII-free product analytics. "vercel" turns on Vercel Web Analytics (enable Analytics for the project in Vercel too); empty = off. Honors Global Privacy Control.
NEXT_PUBLIC_ANALYTICS=

# Set to "true" to show the HUD 223(a)(7) refinance box in the loan sizer (off until a HUD lender confirms the box).
NEXT_PUBLIC_SIZER_HUD_223A7=

# --- Privacy & AI controls (WS-Y) -------------------------------------------------
# AES-256-GCM master key for restricted PII fields (SSN, DOB, account numbers, PFS): openssl rand -base64 32. Without it restricted fields cannot be stored.
PII_ENCRYPTION_KEY=
# Version number of PII_ENCRYPTION_KEY (positive integer, default 1); bump it when rotating.
PII_ENCRYPTION_KEY_VERSION=1
# Older keys still needed to decrypt during rotation, comma-separated "<version>:<key>" (e.g. 1:base64key).
PII_ENCRYPTION_PREVIOUS_KEYS=
# Bearer token (32+ chars) for compliance-staff privacy endpoints (request export/verify, legal hold) until staff auth lands; empty disables them.
PRIVACY_ADMIN_TOKEN=

# --- Staff auth & approvals (WS-I) ------------------------------------------------
# Supabase Auth public (anon / publishable) key, used server-side only for email OTP, magic links and TOTP MFA.
SUPABASE_ANON_KEY=
# Identity provider: empty or "supabase" (needs SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY); "fake" = in-memory demo accounts for dev/e2e (refused in production and alongside a service-role key).
AUTH_PROVIDER=
# Optional HMAC key (32+ chars, openssl rand -base64 32) for the session cookie; defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY.
AUTH_COOKIE_SECRET=
# Absolute staff session lifetime in hours before signing in again (default 12, max 168).
STAFF_SESSION_MAX_HOURS=12
# Port for the fake-auth server e2e/staff.spec.ts starts when the main e2e server is not in fake mode (default E2E_PORT + 1).
E2E_STAFF_PORT=

# --- Deal desk records (WS-T) -----------------------------------------------------
# Set to "true" once counsel approves the SBA Form 159 data-sheet template; until then Form 159 renders as DRAFT and cannot be sent.
SBA159_TEMPLATE_APPROVED=false
# Zoho Sign template for SBA Form 159; field labels must match form159PrefillFields() and roles "Agent", "Applicant 1".."Applicant N", "Lender".
ZOHO_SIGN_SBA159_TEMPLATE_ID=
# BoldSign fallback template for SBA Form 159 (same roles and field labels).
BOLDSIGN_SBA159_TEMPLATE_ID=

# --- Checklists, principals & screening (WS-U) -------------------------------------
# OpenSanctions matching API key (OFAC SDN/consolidated and other sanctions lists). Empty = screening unavailable; deals cannot clear screening.
OPENSANCTIONS_API_KEY=
# OpenSanctions collection to match against (default "sanctions").
OPENSANCTIONS_DATASET=
# OpenSanctions API base URL override (default https://api.opensanctions.org).
OPENSANCTIONS_API_URL=
# Signs borrower-portal session cookies (32+ chars, openssl rand -base64 32). Empty disables the portal.
PORTAL_SESSION_SECRET=
# Hours a portal magic link stays valid before first use (1-168, default 72).
PORTAL_LINK_TTL_HOURS=
# Hours a portal session lasts after the link is opened (1-24, default 8).
PORTAL_SESSION_TTL_HOURS=
# Interim shared token (32+ chars) for the /checklists deal desk until WS-I staff auth is wired in; empty keeps the desk closed.
STAFF_ACCESS_TOKEN=
# Name and email recorded on desk actions taken with the interim token.
STAFF_ACCESS_EMAIL=
STAFF_ACCESS_NAME=

# --- Notifications (WS-J) ----------------------------------------------------------
# Resend transactional email (sent from the notify. subdomain). Empty = email notifications are skipped.
RESEND_API_KEY=
# From address; the domain must be verified in Resend. Default: Kubera Commercial <notifications@notify.kuberacommercial.com>.
RESEND_FROM=
# Reply-To for notification emails; defaults to NEXT_PUBLIC_CONTACT_EMAIL (deals@).
NOTIFY_REPLY_TO=
# Telnyx messaging (10DLC registered number). Empty = text notifications are skipped.
TELNYX_API_KEY=
# E.164 sending number registered to the 10DLC campaign, e.g. +13105550100.
TELNYX_FROM_NUMBER=
# Optional Telnyx messaging profile id.
TELNYX_MESSAGING_PROFILE_ID=
# Telnyx account public key (base64, Ed25519) that verifies /api/webhooks/telnyx; the endpoint answers 503 without it. Turn off Telnyx's own STOP/HELP auto-replies for the profile.
TELNYX_PUBLIC_KEY=
# Comma-separated E.164 numbers of the brokers who get the Tier-1 lead text within 60 seconds.
NOTIFY_STAFF_SMS_NUMBERS=
# Comma-separated staff emails for lead alerts and inbound texts; defaults to NEXT_PUBLIC_CONTACT_EMAIL.
NOTIFY_STAFF_EMAILS=
# Bearer secret (32+ chars) for the internal triggers under /api/notify/* (tier1, lead-confirmation, stage-event).
NOTIFY_INTERNAL_SECRET=
# Extra template versions the broker has pre-approved for automatic sending, e.g. milestone_update@1,milestone_update_sms@1. Anything else waits in the approval queue.
NOTIFY_PREAPPROVED_TEMPLATES=
