# --- Site & compliance -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kuberacommercial.com
# Required before launch: California requires the DRE license number on the website.
NEXT_PUBLIC_DRE_CORPORATE_LICENSE=
NEXT_PUBLIC_DRE_OFFICER_LICENSE=
NEXT_PUBLIC_NMLS_ID=
NEXT_PUBLIC_CONTACT_EMAIL=deals@kuberacommercial.com
NEXT_PUBLIC_CONTACT_PHONE=
# Hosts that render only the express qualifier (proxy.ts).
EXPRESS_HOSTS=kubera.loans,www.kubera.loans

# --- AI ------------------------------------------------------------------------
# Claude ("System Two") for Ask Kubera AI and term sheets.
ANTHROPIC_API_KEY=
# Optional hosted Jev endpoint ("System One"). The built-in rules engine runs when unset.
JEV_API_URL=
JEV_API_KEY=

# --- Twenty CRM ------------------------------------------------------------------
# Base URL without /rest, e.g. https://api.twenty.com or your self-hosted URL.
TWENTY_API_URL=
TWENTY_API_KEY=
# Secret set when creating the webhook (Settings → APIs & Webhooks) pointing at /api/webhooks/twenty.
TWENTY_WEBHOOK_SECRET=

# --- Supabase ------------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security --------------------------------------------------------------------------
# Signs the per-lead upload token (openssl rand -base64 32).
LEAD_TOKEN_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/rates and /api/cron/crm-retry.
CRON_SECRET=

# --- Compliance (WS-A) --------------------------------------------------------
# Main office address on file with the DRE; shown on /licensing and used on the MLDS.
NEXT_PUBLIC_DRE_LICENSED_ADDRESS=
# Set to "true" only after counsel approves the legal pages; until then they show a DRAFT banner.
NEXT_PUBLIC_LEGAL_APPROVED=
# Non-Vercel hosts: set to "production" so the build fails without an 8-digit NEXT_PUBLIC_DRE_CORPORATE_LICENSE (Vercel uses VERCEL_ENV).
DEPLOY_ENV=

# --- Security & AI safety (WS-B) -------------------------------------------------
# Cloudflare Turnstile. Site key is public (rendered in the browser); the secret verifies tokens server-side.
# Leave both empty to disable bot verification (dev/preview). Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST credentials for the shared rate limiter (falls back to per-instance memory when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Extra origins allowed to POST to the intake APIs, comma-separated (e.g. http://localhost:3999 for e2e on next start).
ALLOWED_ORIGINS=
# Salt for hashing client IPs on AI conversation records (openssl rand -base64 32); defaults to LEAD_TOKEN_SECRET.
IP_HASH_SALT=
# Optional CSP violation report endpoint (report-uri).
CSP_REPORT_URI=
# Advisor evals (npm run evals): minimum pass rate and parallel requests for live runs.
EVAL_MIN_PASS_RATE=0.8
EVAL_CONCURRENCY=4

# --- Observability (Sentry; leave empty to disable) ----------------------------------------
# Server and edge DSN. Without a DSN Sentry is never initialised and one info line is logged.
SENTRY_DSN=
# Browser DSN (public by design). Also add the Sentry ingest origin to the CSP connect-src.
NEXT_PUBLIC_SENTRY_DSN=
# Overrides the environment label (defaults to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
# Server/edge trace sample rate between 0 and 1 (default 0.1).
SENTRY_TRACES_SAMPLE_RATE=
# Browser equivalents of the two settings above.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- Testing ---------------------------------------------------------------------------
# Port the Playwright suite serves the production build on (npm run test:e2e). Default 3999.
E2E_PORT=3999

# --- Disclosures & e-sign (WS-W) ------------------------------------------------
# Kubera's DRE-licensed office address for the MLDS (RE 882); defaults to NEXT_PUBLIC_DRE_LICENSED_ADDRESS.
DRE_LICENSED_ADDRESS=
# Set to "true" only after counsel approves the MLDS / funder templates; until then documents say DRAFT and cannot be sent.
MLDS_TEMPLATE_APPROVED=false
# Set to "true" only after counsel rules that California state holidays (Gov. Code §6700) extend business-day clocks (MLDS, privacy); default is federal-only, the strictest reading.
MLDS_CA_OPTIONAL_HOLIDAYS=false
# Force a provider: zoho_sign | boldsign | fake (fake is refused in production and whenever SUPABASE_SERVICE_ROLE_KEY is set; its webhook also needs ZOHO_SIGN_WEBHOOK_SECRET). Empty = Zoho Sign if configured; BoldSign is used only with ESIGN_PROVIDER=boldsign.
ESIGN_PROVIDER=
# Zoho Sign OAuth client (api-console.zoho.com, scopes ZohoSign.documents.ALL,ZohoSign.templates.ALL) and its refresh token.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
# Zoho data center TLD: com (US), eu, in, com.au, jp, ca, sa, com.cn. Anything else disables e-sign (logged once).
ZOHO_SIGN_DC=com
# Zoho Sign template for the MLDS; field labels must match mldsPrefillFields() and roles "Borrower 1".."Borrower N", "Broker".
ZOHO_SIGN_MLDS_TEMPLATE_ID=
# Secret key set on the Zoho Sign webhook pointing at /api/webhooks/zoho-sign.
ZOHO_SIGN_WEBHOOK_SECRET=
# BoldSign fallback (used only with ESIGN_PROVIDER=boldsign). Its webhook points at /api/webhooks/boldsign, signed with BOLDSIGN_WEBHOOK_SECRET.
BOLDSIGN_API_KEY=
BOLDSIGN_WEBHOOK_SECRET=
BOLDSIGN_MLDS_TEMPLATE_ID=

# --- Trust pages (WS-G) ----------------------------------------------------------
# Cal.com booking handle for the /contact embed, e.g. kubera/intro. Empty shows an email fallback instead.
NEXT_PUBLIC_CALCOM_LINK=
# Office address shown on /contact; falls back to NEXT_PUBLIC_DRE_LICENSED_ADDRESS when empty.
NEXT_PUBLIC_OFFICE_ADDRESS=

# --- Analytics (WS-H) -----------------------------------------------------------
# Cookieless, PII-free product analytics. "vercel" turns on Vercel Web Analytics (enable Analytics for the project in Vercel too); empty = off. Honors Global Privacy Control.
NEXT_PUBLIC_ANALYTICS=

# Set to "true" to show the HUD 223(a)(7) refinance box in the loan sizer (off until a HUD lender confirms the box).
NEXT_PUBLIC_SIZER_HUD_223A7=

# --- Privacy & AI controls (WS-Y) -------------------------------------------------
# AES-256-GCM master key for restricted PII fields (SSN, DOB, account numbers, PFS): openssl rand -base64 32. Without it restricted fields cannot be stored.
PII_ENCRYPTION_KEY=
# Version number of PII_ENCRYPTION_KEY (positive integer, default 1); bump it when rotating.
PII_ENCRYPTION_KEY_VERSION=1
# Older keys still needed to decrypt during rotation, comma-separated "<version>:<key>" (e.g. 1:base64key).
PII_ENCRYPTION_PREVIOUS_KEYS=
# (PRIVACY_ADMIN_TOKEN is retired: the privacy admin API now needs an admin staff session with MFA plus a step-up code. Remove it from deployed envs.)

# --- Staff auth & approvals (WS-I) ------------------------------------------------
# Supabase Auth public (anon / publishable) key, used server-side only for email OTP, magic links and TOTP MFA.
SUPABASE_ANON_KEY=
# Identity provider: empty or "supabase" (needs SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY); "fake" = in-memory demo accounts for dev/e2e (refused in production and alongside a service-role key).
AUTH_PROVIDER=
# Optional HMAC key (32+ chars, openssl rand -base64 32) for the session cookie; defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY.
AUTH_COOKIE_SECRET=
# Absolute staff session lifetime in hours before signing in again (default 12, max 168).
STAFF_SESSION_MAX_HOURS=12
# Port for the fake-auth server e2e/staff.spec.ts starts when the main e2e server is not in fake mode (default E2E_PORT + 1).
E2E_STAFF_PORT=

# --- Deal desk records (WS-T) -----------------------------------------------------
# Set to "true" once counsel approves the SBA Form 159 data-sheet template; until then Form 159 renders as DRAFT and cannot be sent.
SBA159_TEMPLATE_APPROVED=false
# Zoho Sign template for SBA Form 159; field labels must match form159PrefillFields() and roles "Agent", "Applicant 1".."Applicant N", "Lender".
ZOHO_SIGN_SBA159_TEMPLATE_ID=
# BoldSign fallback template for SBA Form 159 (same roles and field labels).
BOLDSIGN_SBA159_TEMPLATE_ID=

# --- Checklists, principals & screening (WS-U) -------------------------------------
# OpenSanctions matching API key (OFAC SDN/consolidated and other sanctions lists). Empty = screening unavailable; deals cannot clear screening.
OPENSANCTIONS_API_KEY=
# OpenSanctions collection to match against (default "sanctions").
OPENSANCTIONS_DATASET=
# OpenSanctions API base URL override (default https://api.opensanctions.org).
OPENSANCTIONS_API_URL=
# Signs borrower-portal session cookies (32+ chars, openssl rand -base64 32). Empty disables the portal.
PORTAL_SESSION_SECRET=
# Hours a portal magic link stays valid before first use (1-168, default 72).
PORTAL_LINK_TTL_HOURS=
# Hours a portal session lasts after the link is opened (1-24, default 8).
PORTAL_SESSION_TTL_HOURS=

# --- Notifications (WS-J) ----------------------------------------------------------
# Resend transactional email (sent from the notify. subdomain); also the deal desk's approved lender submissions, gate-H lender notices and invoices. Empty = email is skipped and staff send from their mailbox.
RESEND_API_KEY=
# From address; the domain must be verified in Resend. Default: Kubera Commercial <notifications@notify.kuberacommercial.com>.
RESEND_FROM=
# Reply-To for notification emails; defaults to NEXT_PUBLIC_CONTACT_EMAIL (deals@).
NOTIFY_REPLY_TO=
# Telnyx messaging (10DLC registered number). Empty = text notifications are skipped.
TELNYX_API_KEY=
# E.164 sending number registered to the 10DLC campaign, e.g. +13105550100.
TELNYX_FROM_NUMBER=
# Optional Telnyx messaging profile id.
TELNYX_MESSAGING_PROFILE_ID=
# Telnyx account public key (base64, Ed25519) that verifies /api/webhooks/telnyx; the endpoint answers 503 without it. Turn off Telnyx's own STOP/HELP auto-replies for the profile.
TELNYX_PUBLIC_KEY=
# Comma-separated E.164 numbers of the brokers who get the Tier-1 lead text within 60 seconds.
NOTIFY_STAFF_SMS_NUMBERS=
# Comma-separated staff emails for lead alerts and inbound texts; defaults to NEXT_PUBLIC_CONTACT_EMAIL.
NOTIFY_STAFF_EMAILS=
# Bearer secret (32+ chars) for the internal triggers under /api/notify/* (tier1, lead-confirmation, stage-event).
NOTIFY_INTERNAL_SECRET=
# Extra template versions the broker has pre-approved for automatic sending, e.g. milestone_update@1,milestone_update_sms@1. Anything else waits in the approval queue.
NOTIFY_PREAPPROVED_TEMPLATES=

# --- Lead & document chasers (WS-R) ------------------------------------------------
# Extra "<template>@<version>" chaser templates a broker pre-approved for automatic sending, e.g. document_reminder_email@1. Speed-to-lead is pre-approved in code; every other chaser message waits for a broker. A reworded template needs a new entry. For calls use voice:<script>@<version>.
OUTREACH_PREAPPROVED_TEMPLATES=
# "true" pauses every chaser message and call (kill switch). Anything else leaves them on.
OUTREACH_PAUSED=
# Telnyx Call Control application id for outbound calls. Empty = outbound calls off (the SMS settings above are unaffected).
TELNYX_VOICE_CONNECTION_ID=
# Voice-enabled E.164 number to call from. Defaults to TELNYX_FROM_NUMBER when empty.
TELNYX_VOICE_FROM_NUMBER=
# Where Telnyx posts call events (default <site>/api/webhooks/telnyx-voice). Events are verified with TELNYX_PUBLIC_KEY.
OUTREACH_VOICE_WEBHOOK_URL=

# --- Document vault (WS-K) -------------------------------------------------------
# Optional separate HMAC secret for expiring upload tokens; falls back to LEAD_TOKEN_SECRET. openssl rand -base64 32
DOCUMENT_TOKEN_SECRET=
# Seconds an upload token (and its pending upload) stays valid. Default 900.
DOCUMENT_UPLOAD_TTL_SECONDS=
# Per-lead upload quotas: most files (default 60) and most megabytes (default 500).
DOCUMENT_MAX_FILES_PER_LEAD=
DOCUMENT_MAX_MB_PER_LEAD=
# Malware scanner: clamav | fake (fake is refused in production and whenever SUPABASE_SERVICE_ROLE_KEY is set, the scan worker included). Empty = ClamAV when CLAMAV_REST_URL is set; with no scanner uploads stay quarantined.
SCANNER_PROVIDER=
# Base URL of the clamav-rest sidecar (e.g. https://clamav.internal:9000). clamd StreamMaxLength must be at least 50 MB.
CLAMAV_REST_URL=
# Path of the scan endpoint on that sidecar (default /scan) and optional bearer key if it is behind auth.
CLAMAV_REST_SCAN_PATH=
CLAMAV_REST_API_KEY=
# Per-scan timeout in milliseconds (default 120000).
CLAMAV_REST_TIMEOUT_MS=
# Seconds between polls for `npm run scan:worker` (default 15).
SCAN_POLL_SECONDS=
# AES-256-GCM key for vault file backups (npm run vault -- backup): openssl rand -base64 32. Store it separately from the backups.
VAULT_BACKUP_KEY=

# --- Workflows & AI platform (WS-Q) -------------------------------------------------
# Inngest (workflows served at /api/inngest). Event key sends events; signing key verifies Inngest's calls. Empty = workflows off (events dropped, endpoint 503).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 (or the dev server URL) only when running the local Inngest dev server. Ignored in production, where the keys above are required.
INNGEST_DEV=
# NVIDIA NIM (OpenAI-compatible) behind the model gateway; empty = NIM routes unavailable. Never receives restricted fields.
NVIDIA_API_KEY=
# Override the NIM endpoint (self-hosted NIM) and its default model.
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=
# xAI (Grok) behind the model gateway: market intel from public signals only; the routing guard blocks any borrower data.
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=
# Langfuse tracing of model calls and workflow runs (metadata only). Empty = tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse host (https); default https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=
# "true" also sends prompt/completion text, with everything above internal (PII) redacted first. Default off.
LANGFUSE_CAPTURE_CONTENT=
# Zoho Mail connector (read-only) for deals@, docs@, lenders@, vendors@, closing@. OAuth client from api-console.zoho.com
# with scopes ZohoMail.accounts.READ,ZohoMail.folders.READ,ZohoMail.messages.READ. Empty = inbound mail off.
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
# Zoho data center TLD: com (US), eu, in, com.au, jp, ca, sa, com.cn. Anything else disables e-sign (logged once).
ZOHO_MAIL_DC=com
# Refresh token used for every mailbox unless a per-mailbox token is set below.
ZOHO_MAIL_REFRESH_TOKEN=
# Per-mailbox refresh tokens (minted while signed in as that mailbox); optional.
ZOHO_MAIL_REFRESH_TOKEN_DEALS=
ZOHO_MAIL_REFRESH_TOKEN_DOCS=
ZOHO_MAIL_REFRESH_TOKEN_LENDERS=
ZOHO_MAIL_REFRESH_TOKEN_VENDORS=
ZOHO_MAIL_REFRESH_TOKEN_CLOSING=
# Zoho account id per mailbox; optional (looked up by address via GET /api/accounts when empty).
ZOHO_MAIL_ACCOUNT_ID_DEALS=
ZOHO_MAIL_ACCOUNT_ID_DOCS=
ZOHO_MAIL_ACCOUNT_ID_LENDERS=
ZOHO_MAIL_ACCOUNT_ID_VENDORS=
ZOHO_MAIL_ACCOUNT_ID_CLOSING=
# Domain of the inbound mailboxes (default kuberacommercial.com).
MAIL_DOMAIN=kuberacommercial.com

# --- Multifamily data & California rules (WS-Z) ------------------------------------
# Regrid parcel API token (parcel, owner, year built, units). Empty disables parcel lookups.
REGRID_API_TOKEN=
# OpenCorporates API token for owner-entity status. Empty disables entity lookups.
OPENCORPORATES_API_TOKEN=
# ATTOM Property API key (deed, mortgage, sales comps). Empty disables ATTOM lookups.
ATTOM_API_KEY=
# HelloData API key (rent comps, expense benchmarks). Empty disables HelloData lookups.
HELLODATA_API_KEY=
# Override for the HelloData API origin if the account uses a different host.
HELLODATA_BASE_URL=
# Rentometer API key (rent estimates by bedroom count). Empty disables Rentometer lookups.
RENTOMETER_API_KEY=
# FEMA NFHL flood-zone lookups use a public service and need no key; set to "false" to turn them off.
FEMA_NFHL_ENABLED=
# Days a merged property lookup stays cached in property_facts (default 30).
PROPERTY_FACTS_TTL_DAYS=

# --- Construction desk (WS-AA) -----------------------------------------------------
# "true" turns on the California contractor license lookup (CSLB public record) for the construction desk. Off by default: licenses are then verified by hand.
CSLB_LOOKUP_ENABLED=
# Override the CSLB site root (tests and proxies only). Empty uses https://www.cslb.ca.gov.
CSLB_LOOKUP_BASE_URL=

# --- Document agent & spreads (WS-L) ------------------------------------------------
# NVIDIA NeMo Retriever extraction endpoint (PDF -> text/tables) for PDFs without a readable text layer; empty = Claude reads those PDFs. Uses NVIDIA_API_KEY when the endpoint is hosted. Never receives PFS or untyped documents.
NVIDIA_NEMO_RETRIEVER_URL=
# Model id for text-based structured extraction through the gateway (empty = the default Claude tier; an nvidia/... id routes confidential documents to NIM).
DOCUMENT_TEXT_MODEL=
# Effort for extraction calls: low | medium | high | xhigh | max (default medium).
DOCUMENT_EXTRACTION_EFFORT=

# --- Lender matching (WS-M) ----------------------------------------------------------
# Term sheets from lenders@ are parsed with ANTHROPIC_API_KEY (rules fallback without it; those quotes all go to review).
# Optional index level (percent) used when a floating-rate term sheet quotes only "SOFR + spread". Empty = staff enter the all-in rate.
LENDER_INDEX_SOFR_PCT=
# Optional WSJ Prime level (percent) for "Prime + spread" term sheets.
LENDER_INDEX_PRIME_PCT=
# Optional Treasury level (percent) for "Treasury + spread" term sheets.
LENDER_INDEX_TREASURY_PCT=

# --- CRM agents (WS-N) ---------------------------------------------------------------
# Twenty API key for the CRM agents only. Give it a role limited to opportunities, companies, people, notes, tasks and their targets; falls back to TWENTY_API_KEY (with a warning) when empty.
TWENTY_AGENT_API_KEY=
# How freely the CRM agents act: audit (log only), assist (every write waits for a broker), automate (notes and tasks write directly; stage, owner and merge changes still wait for a broker). Per-task overrides: "automate,dedupe=audit,stage_sync=assist". Default automate.
CRM_AGENT_AUTONOMY=
# Optional JSON map of deal-desk stage -> Twenty opportunity stage, e.g. {"term_sheet":"TERM_SHEET"}. Overrides the defaults in lib/agents/crm/stage-map.ts.
TWENTY_STAGE_MAP=

# --- AI supervision & reporting (WS-O) ----------------------------------------------
# Output guardrails on Ask Kubera AI replies (commitment language, legal advice, usury-exemption claims, guaranteed timelines).
# "monitor" records hits for staff review without rewriting the reply; anything else enforces. Default enforce.
AI_GUARDRAILS_MODE=
# Knowledge-base embeddings (kb_chunks, 1024 dimensions). Empty keys = full-text retrieval only. Unset EMBEDDINGS_PROVIDER picks Voyage, then NVIDIA.
# Set to voyage, nvidia or off to pin one.
EMBEDDINGS_PROVIDER=
# Voyage AI key for embeddings (1024-dim model). Texts pass the model routing guard first; restricted values are redacted.
VOYAGE_API_KEY=
# Override the Voyage and NVIDIA embedding model ids (changing one re-embeds everything on the next npm run kb:ingest).
VOYAGE_EMBED_MODEL=
NVIDIA_EMBED_MODEL=

# --- Growth: newsletter (WS-P) -----------------------------------------------------
# Resend audience id for the newsletter (Resend Broadcasts are sent to it from the news. subdomain). Confirmed subscribers are added to it and unsubscribes are flagged on it. Empty = signups are recorded but the audience is not updated (flagged on the subscriber row).
RESEND_AUDIENCE_ID=
# Signing secret (16+ characters) for the emailed confirm and unsubscribe links. Falls back to LEAD_TOKEN_SECRET. Without either, newsletter signups answer 503.
NEWSLETTER_TOKEN_SECRET=
# Svix signing secret (whsec_...) for the Resend webhook at /api/newsletter/webhook (contact.updated and email.complained events keep the consent ledger in step with Resend unsubscribes). Empty = the endpoint answers 503.
RESEND_WEBHOOK_SECRET=

# --- Market intel & prospecting (WS-S) -----------------------------------------------
# The weekly market-intel note uses XAI_API_KEY / XAI_MODEL (above) through the model gateway, public signals only. Without a key the note is a rules digest.
# Extra public RSS/Atom feeds for the weekly note, comma or space separated (https only). Rates (FRED) and HUD/SBA Federal Register notices are always included.
INTEL_FEED_URLS=
# Recorded-mortgage provider for refinance-maturity scans: auto (default) or attom use ATTOM_API_KEY (above; confirm the ATTOM agreement permits prospecting); off disables scans.
MATURITY_PROVIDER=
# Market note rate (percent) used by the prospect score's rate-pressure factor. VERIFY quarterly. Default 6.25.
PROSPECT_MARKET_RATE_PCT=

# --- Shared Zoho OAuth tokens (final fixes r1) --------------------------------------
# UPSTASH_REDIS_REST_URL/TOKEN (above) also hold Zoho Mail and Zoho Sign access tokens so every instance shares one token per refresh token; unset = per-instance cache.
