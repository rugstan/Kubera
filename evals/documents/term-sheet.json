{
  "docType": "TERM_SHEET",
  "cases": [
    {
      "id": "term-sheet-letter",
      "description": "Bank term sheet as 'Label: value' text.",
      "source": {
        "format": "text",
        "lines": [
          "Indicative Term Sheet",
          "Lender: Pacific Coast Bank",
          "Loan Amount: $12,500,000",
          "Interest Rate: 6.25% fixed",
          "Rate Type: Fixed",
          "Amortization: 30 years",
          "Interest Only Period: 12 months",
          "Term: 10 years",
          "Origination Fee: 1.00%",
          "Exit Fee: None",
          "Maximum LTV: 65%",
          "Minimum DSCR: 1.25x",
          "Prepayment: 5-4-3-2-1 step-down",
          "Recourse: Non-recourse with standard carve-outs"
        ]
      },
      "expected": {
        "status": "extracted",
        "scalars": {
          "lenderName": "Pacific Coast Bank",
          "loanAmount": 12500000,
          "interestRatePct": 6.25,
          "rateType": "Fixed",
          "amortizationYears": 30,
          "interestOnlyMonths": 12,
          "termMonths": 120,
          "originationFeePct": 0.01,
          "maxLtv": 0.65,
          "minDscr": 1.25,
          "prepayment": "5-4-3-2-1 step-down",
          "recourse": "Non-recourse with standard carve-outs"
        }
      }
    },
    {
