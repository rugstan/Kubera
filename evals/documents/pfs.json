          "totalAssets": 1500000,
          "totalLiabilities": 600000,
          "netWorth": 900000
        }
      }
    },
    {
      "id": "pfs-mismatch-xlsx",
      "description": "Stated total assets do not equal the parts: the statement goes to review.",
      "source": {
        "format": "xlsx",
        "sheets": [
          {
            "name": "PFS",
            "rows": [
              [
                "As of",
                "2026-04-30"
              ],
              [
                "Cash",
                300000
              ],
              [
                "Stocks and bonds",
                600000
              ],
              [
                "Real estate",
                1000000
              ],
              [
                "Total assets",
                2000000
              ],
              [
                "Total liabilities",
                400000
              ],
              [
                "Net worth",
                1600000
              ]
            ]
          }
        ]
      },
      "expected": {
        "status": "needs_review",
        "warnings": [
          "assets_mismatch"
